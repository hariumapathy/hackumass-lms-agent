# Copy to .env (git-ignored) and fill in. Never commit real values.
# Local Supabase (`make db`) prints its URL/keys on start; hosted values come from the Supabase dashboard.

# --- Web (public) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- API + worker (server only, never expose to the browser) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Either the JWT secret (HS256) or the JWKS URL (asymmetric keys)
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Fernet key for tokens/cookies. Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Optional: OpenAI/Claude models in the picker (Settings > Advanced)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# REQUIRED: default chat model + embeddings (free key: https://aistudio.google.com)
GEMINI_API_KEY=
# Gemini model behind the default choice (optional)
GEMINI_MODEL=gemini-3.5-flash
# Chat: auto (real agent if a model key is set, else scripted demo stream) | agent | scripted
CHAT_MODE=auto
# gemini (default) | openai | fake (tests)
EMBEDDINGS_PROVIDER=gemini
WEB_ORIGIN=http://localhost:3000
# Public base URL of this API (calendar feed links point here)
PUBLIC_API_URL=http://localhost:8000
# local (headed browser on this machine) | hosted
BROWSER_PROVIDER=local
CANVAS_BASE_URL=https://umass.instructure.com
